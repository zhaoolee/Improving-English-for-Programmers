# --- 本地私有 / 不应公开 ---
.local-backup/
MEMORY/
.DS_Store
**/.DS_Store
__pycache__/
**/__pycache__/
.env
.env.*
*.env
**/credentials*
**/*secret*
**/*.pem
**/*.key

# --- scene-cards-850：默认忽略，仅白名单可提交 ---
scene-cards-850/*
!scene-cards-850/cards/
!scene-cards-850/prompts/
!scene-cards-850/images/
!scene-cards-850/piclex/
!scene-cards-850/scripts/
!scene-cards-850/workflow/
!scene-cards-850/START_HERE.txt
!scene-cards-850/cards_plan.json
!scene-cards-850/words_850.json
!scene-cards-850/words_850.txt
!scene-cards-850/validate_coverage.py
!scene-cards-850/coverage_report.json

# 卡片：100 json + 100 txt
scene-cards-850/cards/*
!scene-cards-850/cards/*.json
!scene-cards-850/cards/*.txt

# 图片：仅 100 张 Cxxx.png（忽略 compressed/、archive/ 等）
scene-cards-850/images/*
!scene-cards-850/images/C*.png

# PicLex：仅 annotations 与 job（忽略 receipt/其它本地回执）
scene-cards-850/piclex/*
!scene-cards-850/piclex/*_annotations.json
!scene-cards-850/piclex/*_job.json

# 脚本：全部可提交，除本机部署辅助 publish-reviewed-release.mjs 与 __pycache__
scene-cards-850/scripts/__pycache__/
scene-cards-850/scripts/publish-reviewed-release.mjs

# workflow：README、调色板、styles/、暖图参考、批次内容与审图
scene-cards-850/workflow/*
!scene-cards-850/workflow/README.md
!scene-cards-850/workflow/label-palette.json
!scene-cards-850/workflow/*_batch_content.json
!scene-cards-850/workflow/*_review.json
!scene-cards-850/workflow/styles/
!scene-cards-850/workflow/references/
scene-cards-850/workflow/references/*
!scene-cards-850/workflow/references/instagram-warm.png

# --- programmer-work-english：默认忽略，仅白名单可提交（公开源与本地运行材料分离）---
programmer-work-english/*
!programmer-work-english/README.md
!programmer-work-english/cards_plan.json
!programmer-work-english/START_HERE.txt
!programmer-work-english/cards/
!programmer-work-english/images/
!programmer-work-english/prompts/
!programmer-work-english/piclex/
!programmer-work-english/scripts/
!programmer-work-english/workflow/
!programmer-work-english/workflow/styles/

# 卡片：仅 Wxxx.json / Wxxx.txt
programmer-work-english/cards/*
!programmer-work-english/cards/*.json
!programmer-work-english/cards/*.txt

# 图片：仅 Wxxx.png（忽略预览、压缩、备份等）
programmer-work-english/images/*
!programmer-work-english/images/W[0-9][0-9][0-9].png
# 反色（黑底白线）发布图：公开源，原图保留
!programmer-work-english/images/inverted/
programmer-work-english/images/inverted/*
!programmer-work-english/images/inverted/W[0-9][0-9][0-9].png

# PicLex：仅 annotations 与 job（忽略 receipt/预览/其它本地回执）
programmer-work-english/piclex/*
!programmer-work-english/piclex/*_annotations.json
!programmer-work-english/piclex/*_job.json

# 脚本：全部可提交，除 __pycache__
programmer-work-english/scripts/__pycache__/

# workflow：README、调色板、styles/、批次内容与审图保留；其余一律本地忽略：
# generation-index、pi 任务/日志、scaffold-result、files-ready、offline-acceptance、
# region-decisions、回执、预览、计时、acceptance、发布/目录(catalog)、draft、运行日志等。
programmer-work-english/workflow/*
!programmer-work-english/workflow/README.md
!programmer-work-english/workflow/label-palette.json
!programmer-work-english/workflow/*_batch_content.json
!programmer-work-english/workflow/*_review.json
!programmer-work-english/workflow/styles/
programmer-work-english/workflow/styles/*
!programmer-work-english/workflow/styles/*.txt
programmer-work-english/workflow/__pycache__/
